/// Sales representatives and managers, one per territory.
table Salesperson

	column SalespersonKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: SalespersonKey

	column Salesperson
		dataType: string
		isDefaultLabel
		summarizeBy: none
		sourceColumn: SalespersonName

	column Title
		dataType: string
		summarizeBy: none
		sourceColumn: Title

	column TerritoryKey
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: TerritoryKey

	column Region
		dataType: string
		summarizeBy: none
		sourceColumn: Region

	column 'Hire Date'
		dataType: string
		summarizeBy: none
		sourceColumn: HireDate

	partition Salesperson = m
		mode: import
		source =
				let
					Source = Sql.Database("bidogiressnu7mprkzh7qhatvq-jhhycmnebfpudkfevo3gnxsq7m.datawarehouse.fabric.microsoft.com", "Novolex_Sales"),
					Data = Source{[Schema="dbo",Item="dimsalesperson"]}[Data]
				in
					Data

